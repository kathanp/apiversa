              "const": "field.split"
            },
            "schema": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/path"
            },
            "left": {
              "$ref": "#/$defs/path"
            },
            "right": {
              "$ref": "#/$defs/path"
            },
            "separator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "scope": {
              "$ref": "#/$defs/scope"
            }
          },
          "required": [
            "schema",
