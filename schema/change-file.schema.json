{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kathanp/apiversa/schema/change-file.schema.json",
  "title": "apiversa change file and versions file, format 1",
  "oneOf": [
    {
      "$ref": "#/$defs/versionsFile"
    },
    {
      "$ref": "#/$defs/changeFile"
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z_*][A-Za-z0-9_*]*(\\[\\])?(\\.[A-Za-z_*][A-Za-z0-9_*]*(\\[\\])?){0,31}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "routePath": {
      "type": "string",
      "pattern": "^/"
    },
    "expr": {},
    "versionsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "versions"
      ],
      "properties": {
        "format": {
          "const": 1
        },
        "head": {
          "$ref": "#/$defs/date"
        },
        "default": {
          "enum": [
            "latest",
            "oldest",
            "pin-on-first-call"
          ]
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/date"
              },
              "deprecated": {
                "type": "boolean"
              },
              "sunset": {
                "$ref": "#/$defs/date"
              },
              "sunsetEnforce": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "changeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "description",
        "changes"
      ],
      "properties": {
        "format": {
          "const": 1
        },
        "version": {
          "$ref": "#/$defs/date"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "draft": {
          "type": "boolean"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/op"
          }
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "op"
      ],
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "field.rename"
            },
            "schema": {
              "$ref": "#/$defs/name"
            },
            "from": {
              "$ref": "#/$defs/path"
            },
            "to": {
              "$ref": "#/$defs/path"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            }
          },
          "required": [
            "schema",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
