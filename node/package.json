    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "express": "^5.1.0",
    "fast-check": "^3.23.2",
    "fastify": "^5.6.0",
